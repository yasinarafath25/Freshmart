{
  // Cloudflare Worker for FreshMart (Next.js via @opennextjs/cloudflare).
  // Secrets (DATABASE_URL, APP_URL, TELEGRAM_*, …) are set by the GitHub deploy workflow — never put them here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freshmart",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "freshmart" }],
  "vars": {
    "SSLCOMMERZ_SANDBOX": "true"
  },
  "observability": { "enabled": true }

  // ── Optional upgrades (uncomment after creating them; see README → Deployment) ──
  //
  // Faster database connections through Hyperdrive:
  //   npx wrangler hyperdrive create freshmart-db --connection-string="postgres://…"
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<id printed by the command>" }],
  //
  // Photo uploads from the admin panel (Cloudflare R2 must be enabled on the account):
  //   npx wrangler r2 bucket create freshmart-media
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "freshmart-media" }],
}
