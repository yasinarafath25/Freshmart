# Copy to .env.local for development. In production set these as Wrangler vars/secrets.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/freshmart
APP_URL=http://localhost:3000
# Optional: transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM="FreshMart <orders@example.com>"
# Optional: SSLCommerz online payments (leave empty to disable)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Seed script only (first super admin)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
